generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentFormat {
  SCREENPLAY
  BLOG
  ACADEMIC
}

enum PostType {
  STATUS      // short update, no attached document
  EXCERPT     // snippet of a document, links back to it
  PUBLISHED   // full document shared publicly
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  handle        String    @unique
  displayName   String
  bio           String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())

  documents     Document[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]

  following     Follow[]  @relation("follower")
  followedBy    Follow[]  @relation("following")

  collaborators DocumentCollaborator[]
}

model Follow {
  id            String    @id @default(cuid())
  follower      User      @relation("follower", fields: [followerId], references: [id])
  followerId    String
  following     User      @relation("following", fields: [followingId], references: [id])
  followingId   String
  createdAt     DateTime  @default(now())

  @@unique([followerId, followingId])
}

// A Document is the actual piece of writing. Content is stored as the
// ProseMirror/Tiptap JSON tree; `format` determines which editor mode,
// export renderer, and validation rules apply to it.
model Document {
  id            String          @id @default(cuid())
  title         String
  format        DocumentFormat
  content       Json            // ProseMirror JSON doc
  yjsState      Bytes?          // last-persisted Yjs binary update, for collab recovery
  isPublic      Boolean         @default(false)
  owner         User            @relation(fields: [ownerId], references: [id])
  ownerId       String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  collaborators DocumentCollaborator[]
  posts         Post[]
}

// Join table for multi-user real-time collaboration permissions
model DocumentCollaborator {
  id            String    @id @default(cuid())
  document      Document  @relation(fields: [documentId], references: [id])
  documentId    String
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  role          String    @default("editor") // editor | viewer

  @@unique([documentId, userId])
}

model Post {
  id            String    @id @default(cuid())
  type          PostType
  body          String?   // status text, or excerpt caption
  author        User      @relation(fields: [authorId], references: [id])
  authorId      String
  document      Document? @relation(fields: [documentId], references: [id])
  documentId    String?
  createdAt     DateTime  @default(now())

  comments      Comment[]
  likes         Like[]
}

model Comment {
  id            String    @id @default(cuid())
  body          String
  author        User      @relation(fields: [authorId], references: [id])
  authorId      String
  post          Post      @relation(fields: [postId], references: [id])
  postId        String
  createdAt     DateTime  @default(now())
}

model Like {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  post          Post      @relation(fields: [postId], references: [id])
  postId        String
  createdAt     DateTime  @default(now())

  @@unique([userId, postId])
}
